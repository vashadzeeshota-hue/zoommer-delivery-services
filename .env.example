# Neon pooled connection string (keep this secret)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: self-hosted or managed Photon-compatible geocoder
PHOTON_BASE_URL=https://photon.komoot.io

# One-time values used only by `npm run user:create`
BOOTSTRAP_USER_EMAIL=employee@zoommer.ge
BOOTSTRAP_USER_PASSWORD=replace-with-a-long-temporary-password
BOOTSTRAP_USER_NAME=Employee Name
BOOTSTRAP_USER_ROLE=operator
